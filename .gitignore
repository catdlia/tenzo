# =========================
# Tenzo Compiler .gitignore
# =========================

# Build directories and CMake files
build/
build_*/
cmake-build-*/
out/
bin/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
.cmake/

# Compiled libraries and binaries
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.spv
*.ll
*.bc
*.asm
*.s
*.mlir.tmp

# Models, weights, and export directories
models/
weights/
BitNet/
tenzo-frontend/export_output*/
tenzo-frontend/export_real_*/
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.onnx

# Generated compiler output
optimized.mlir

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
/.python_libs/

# IDEs, Editors, and AI tools
.idea/
.vscode/
*.swp
*.swo
*~
*.code-workspace
.aider*
_llm_context.md
.agents/
implementation_plan.md
prompt_draft.md

# Benchmark results (generated)
benchmark_results/

# CCache
.ccache/
ccache_data/

# Logs and environment
*.log
!results/**/*.log
.env
.env.*
.DS_Store
Thumbs.db

# Reference binaries (regenerate with tools/reference/*; manifest in results/reference/MANIFEST.sha256)
*.f32

# >5 MB downloaded tokenizer, idle benchmark runner outputs & H1b tmp chunks
tools/tokenizer/bitnet_b158_tokenizer.json
results/2026-11-24_B1/
results/2026-11-24_agent2/B1_dryrun/
results/2026-11-24_agent2/H1b/scores/_tmp_*
results/2026-11-24_agent2/L2/dumps/
