# =========================
# Tenzo Compiler .gitignore
# =========================

# Build directories and CMake files
build/
build_*/
cmake-build-*/
out/
bin/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
.cmake/

# Compiled libraries and binaries
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.spv
*.ll
*.bc
*.asm
*.s
*.mlir.tmp

# Models, weights, and export directories
models/
BitNet/
tenzo-frontend/export_output*/
tenzo-frontend/export_real_*/
*.safetensors
*.gguf
*.bin
*.pt
*.onnx

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
/.python_libs/

# IDEs, Editors, and AI tools
.idea/
.vscode/
*.swp
*.swo
*~
.aider*
_llm_context.md

# CCache
.ccache/
ccache_data/

# Logs and environment
*.log
.env
.env.*
.DS_Store
Thumbs.db
